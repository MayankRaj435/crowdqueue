# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
# Production can use comma-separated origins, for example:
# CLIENT_URL=http://localhost:3000,https://your-vercel-app.vercel.app

# Database
MONGO_URI=mongodb://mongo:27017/crowdqueue

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_different_from_above
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMS (Twilio) — Phase 4
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token
TWILIO_PHONE=+1234567890

# Web Push Notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@crowdqueue.app

# Super Admin Seed
SUPER_ADMIN_PHONE=9999999999
SUPER_ADMIN_PASSWORD=admin123456
SUPER_ADMIN_NAME=Super Admin
